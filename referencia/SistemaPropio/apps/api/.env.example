# Para ejecutar la API sin Docker. Copie a apps/api/.env
APP_ENV=development
AUTH_MODE=demo,local
DATABASE_URL=postgresql+psycopg://sistema:CAMBIAR@localhost:5432/sistema_propio
SESSION_SECRET=
COOKIE_SECURE=false
# Tests: base de datos SEPARADA que se borra y recrea en cada ejecución
TEST_DATABASE_URL=postgresql+psycopg://sistema:CAMBIAR@localhost:5432/sistema_propio_test
# AT-29: base auxiliar donde se restaura cada copia para comprobarla (nunca la base en uso)
RESTORE_DATABASE_URL=postgresql+psycopg://sistema:CAMBIAR@localhost:5432/sistema_propio_comprobacion
# Tests de copias: base auxiliar de pruebas (nombre terminado en _test)
RESTORE_TEST_DATABASE_URL=postgresql+psycopg://sistema:CAMBIAR@localhost:5432/sistema_propio_restore_test

# F2.3 Portal del cliente: correo saliente (códigos de acceso y avisos SIN contenido). Proveedor con contrato de
# encargo de tratamiento en la UE (T-33). Si se deja vacío, no sale ningún correo; en desarrollo el código de acceso
# se muestra en la pantalla del portal para poder probar.
WEB_ORIGIN=http://localhost:3000
# CIF/NIF del despacho (separados por comas). La lectura de facturas recibidas lo descarta para no confundirlo
# con el del proveedor. Se escribe solo aquí, en el .env de cada instalación.
OWN_TAX_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Despacho <no-responder@despacho.invalid>
