# Copie a .env y complete. NUNCA suba .env al repositorio.
POSTGRES_USER=sistema
POSTGRES_PASSWORD=
POSTGRES_DB=sistema_propio

# development | test | staging | production
APP_ENV=development
# Métodos de acceso separados por comas: demo (solo development/test), local (contraseña + código
# del móvil) y oidc (proveedor corporativo con MFA, pendiente de T-01)
AUTH_MODE=demo,local
# Genere uno: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true obligatorio en producción (HTTPS)
COOKIE_SECURE=false

# Clave para cifrar los secretos de doble verificación. OBLIGATORIA fuera de desarrollo. Genere una:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# OIDC (pendiente de T-01). La URL de retorno a registrar en el proveedor es
# <WEB_ORIGIN>/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# F2.3 Portal del cliente: correo saliente (códigos de acceso y avisos SIN contenido). Proveedor con contrato de
# encargo de tratamiento en la UE (T-33). Si se deja vacío, no sale ningún correo; en desarrollo el código de acceso
# se muestra en la pantalla del portal para poder probar.
WEB_ORIGIN=http://localhost:3000
# CIF/NIF del despacho (separados por comas). La lectura de facturas recibidas lo descarta para no confundirlo
# con el del proveedor. Se escribe solo aquí, en el .env de cada instalación.
OWN_TAX_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Despacho <no-responder@despacho.invalid>
