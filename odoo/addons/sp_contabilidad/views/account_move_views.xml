<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sp_contabilidad" model="ir.ui.view">
        <field name="name">account.move.form.sp_contabilidad</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sp_leer_factura" type="object" string="Leer factura" icon="fa-magic"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group name="sp_proveedor" invisible="move_type not in ('in_invoice', 'in_refund')">
                    <group>
                        <field name="sp_total_documento" readonly="state != 'draft'"/>
                        <field name="sp_lectura_confianza" invisible="not sp_lectura_confianza"/>
                    </group>
                    <group>
                        <field name="sp_motivo_duplicado" readonly="state != 'draft'"
                               placeholder="Solo si Odoo avisa de una posible factura repetida"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
