<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sp_sede_list" model="ir.ui.view">
        <field name="name">sp.sede.list</field>
        <field name="model">sp.sede</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <field name="receipt_sequence_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="sp_sede_form" model="ir.ui.view">
        <field name="name">sp.sede.form</field>
        <field name="model">sp.sede</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="journal_id"/>
                        <field name="receipt_sequence_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sp_sede" model="ir.actions.act_window">
        <field name="name">Sedes</field>
        <field name="res_model">sp.sede</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
