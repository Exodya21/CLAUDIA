<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_sp_recepcion" model="res.groups.privilege">
        <field name="name">Recepción y cajas</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">8</field>
    </record>

    <record id="group_sp_recepcion" model="res.groups">
        <field name="name">Recepción</field>
        <field name="sequence">10</field>
        <field name="comment">Registra cobros con justificante y cuenta la caja de su sede.</field>
        <field name="privilege_id" ref="res_groups_privilege_sp_recepcion"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_sp_responsable" model="res.groups">
        <field name="name">Responsable de caja y cobros (Contabilidad)</field>
        <field name="sequence">20</field>
        <field name="comment">Confirma y anula cobros, valida o rechaza los cierres de caja que han contado otras personas.</field>
        <field name="privilege_id" ref="res_groups_privilege_sp_recepcion"/>
        <field name="implied_ids" eval="[(4, ref('group_sp_recepcion'))]"/>
    </record>

    <record id="group_sp_devolucion_revision" model="res.groups">
        <field name="name">Atención al cliente · revisar devoluciones</field>
        <field name="sequence">30</field>
        <field name="comment">Revisa las devoluciones, escribe el informe y las escala al letrado. No las aprueba.</field>
        <field name="privilege_id" ref="res_groups_privilege_sp_recepcion"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_sp_devolucion_letrado" model="res.groups">
        <field name="name">Letrado · informe de devoluciones</field>
        <field name="sequence">40</field>
        <field name="comment">Emite el informe jurídico de las devoluciones escaladas. No las aprueba.</field>
        <field name="privilege_id" ref="res_groups_privilege_sp_recepcion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Contabilidad también revisa devoluciones (como en Sistema Propio). -->
    <record id="group_sp_responsable" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sp_recepcion')), (4, ref('group_sp_devolucion_revision'))]"/>
    </record>
</odoo>
