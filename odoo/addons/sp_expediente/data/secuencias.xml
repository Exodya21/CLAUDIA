<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- AL-07 (16/11/2026): ÁREA-AÑO-NÚMERO, sin saltos, reinicio cada año. -->
    <record id="seq_expediente_laboral" model="ir.sequence">
        <field name="name">Expedientes · Laboral</field>
        <field name="code">sp.expediente.laboral</field>
        <field name="prefix">LAB-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_expediente_extranjeria" model="ir.sequence">
        <field name="name">Expedientes · Extranjería</field>
        <field name="code">sp.expediente.extranjeria</field>
        <field name="prefix">EXT-%(range_year)s-</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
